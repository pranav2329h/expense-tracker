# Firebase web app configuration
# Firebase Console → Project settings (gear icon) → General → Your apps → Web app → SDK setup and configuration → Config
# These values identify your Firebase project; they are not secrets. Your data is protected by
# Firebase Authentication + Firestore Security Rules (see firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check (see docs/FIREBASE_SETUP.md, step 9)
# Leave empty to run without App Check (recommended for local development).
VITE_FIREBASE_APPCHECK_SITE_KEY=
# "recaptcha-enterprise" (default) or "recaptcha-v3"
VITE_FIREBASE_APPCHECK_PROVIDER=recaptcha-enterprise
# Development only: a debug token registered in Firebase Console → App Check → Apps → Manage debug tokens
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
